{
  "name": "@dheerajsom/pinhub",
  "version": "0.2.1",
  "description": "Hardware board pinout diagrams in your terminal. `ph rpi5` and go.",
  "keywords": [
    "pinout",
    "gpio",
    "raspberry-pi",
    "arduino",
    "esp32",
    "pico",
    "hardware",
    "cli",
    "terminal"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Dheerajsom/PinHub#readme",
  "bugs": {
    "url": "https://github.com/Dheerajsom/PinHub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dheerajsom/PinHub.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "ph": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "generate:boards": "tsx scripts/generate-boards.ts",
    "check:boards": "tsx scripts/generate-boards.ts --check",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "package:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check:boards && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
