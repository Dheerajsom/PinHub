"# PinHub pin plan: Raspberry Pi Pico (raspberry-pi-pico)
# Connector: 40-pin castellated DIP edge
# Revision notes: none recorded in PinHub; check your board's silkscreen revision.
# Verify against: Raspberry Pi Pico pinout PDF https://pip-assets.raspberrypi.com/categories/610-raspberry-pi-pico/documents/RP-008309-DS-1-Pico-R3-A4-Pinout.pdf
# Pin functions from: https://github.com/raspberrypi/pico-sdk/blob/2.3.1/src/rp2040/hardware_regs/include/hardware/regs/io_bank0.h
# Pin functions from: https://github.com/raspberrypi/pico-sdk/blob/2.3.1/src/boards/include/boards/pico.h
# Pin functions from: https://github.com/raspberrypi/pico-sdk/blob/2.3.1/src/rp2_common/hardware_adc/include/hardware/adc.h
# Pin functions from: https://github.com/micropython/micropython/blob/v1.27.0/ports/rp2/machine_spi.c
# Pin functions from: https://github.com/micropython/micropython/blob/v1.27.0/ports/rp2/machine_i2c.c
# Pin functions from: https://github.com/micropython/micropython/blob/v1.27.0/ports/rp2/machine_uart.c
# Generated by PinHub — verify against the source before wiring. 2026-09-26

from machine import ADC, I2C, PWM, Pin, SPI, UART

i2c0 = I2C(0, sda=Pin(4), scl=Pin(5))  # I2C 1: physical pin 6, GP4; physical pin 7, GP5
spi0 = SPI(0, sck=Pin(18), mosi=Pin(19), miso=Pin(16))  # SPI 1: physical pin 24, GP18; physical pin 25, GP19; physical pin 21, GP16; physical pin 22, GP17
spi0_cs = Pin(17, Pin.OUT, value=1)
uart0 = UART(0, tx=Pin(0), rx=Pin(1))  # UART 1: physical pin 1, GP0; physical pin 2, GP1
pwm1 = PWM(Pin(2))  # PWM 1: physical pin 4, GP2 (PWM1 A)
pwm2 = PWM(Pin(3))  # PWM 2: physical pin 5, GP3 (PWM1 B)
adc1 = ADC(Pin(26))  # ADC 1: physical pin 31, GP26 (ADC CH0)
gpio1 = Pin(6)  # GPIO 1: physical pin 9, GP6
gpio2 = Pin(7)  # GPIO 2: physical pin 10, GP7
"
`;
