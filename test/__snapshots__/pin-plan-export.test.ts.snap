"# PinHub pin plan: ESP32-DevKitC V4 (esp32-devkitc)
# Connector: ESP32-DevKitC V4 J2/J3 headers
# Revision note: D0, D1, D2, D3, CMD, and CLK connect to module flash and are not recommended for other uses.
# Revision note: GPIO16 and GPIO17 are unavailable on ESP32-WROVER module variants; verify the installed module and board revision.
# Revision note: D0, D1, D2, D3, CMD, and CLK connect to module flash and are not recommended for general use.
# Verify against: ESP32-DevKitC V4 user guide https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32/esp32-devkitc/user_guide.html
# Pin functions from: https://docs.espressif.com/projects/esp-idf/en/v5.4/esp32/api-reference/peripherals/gpio.html
# Pin functions from: https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32/esp32-devkitc/user_guide.html
# Pin functions from: https://github.com/espressif/esp-idf/blob/v5.4/components/soc/esp32/include/soc/adc_channel.h
# Pin functions from: https://github.com/espressif/esp-idf/blob/v5.4/components/soc/esp32/include/soc/dac_channel.h
# Pin functions from: https://github.com/espressif/esp-idf/blob/v5.4/components/soc/esp32/include/soc/spi_pins.h
# Pin functions from: https://github.com/espressif/esp-idf/blob/v5.4/components/soc/esp32/include/soc/uart_pins.h
# Pin functions from: https://github.com/espressif/esp-idf/blob/v5.4/components/soc/esp32/include/soc/soc_caps.h
# Pin functions from: https://github.com/espressif/arduino-esp32/blob/3.3.9/variants/esp32/pins_arduino.h
# Pin functions from: https://github.com/espressif/arduino-esp32/blob/3.3.9/libraries/Wire/src/Wire.cpp
# Pin functions from: https://github.com/micropython/micropython/blob/v1.27.0/ports/esp32/machine_hw_spi.c
# Pin routing: Espressif: “Through IO MUX, RTC IO MUX and the GPIO matrix, peripheral input signals can be from any IO pins, and peripheral output signals can be routed to any IO pins.” ADC and DAC channels stay on their fixed pins.
# Generated by PinHub — verify against the source before wiring. 2026-09-26

from machine import ADC, DAC, I2C, PWM, Pin, SPI, UART

i2c0 = I2C(0, sda=Pin(21), scl=Pin(22))  # I2C 1: J3 position 6, IO21; J3 position 3, IO22
spi3 = SPI(2, sck=Pin(18), mosi=Pin(23), miso=Pin(19))  # SPI 1: J3 position 9, IO18; J3 position 2, IO23; J3 position 8, IO19; J3 position 13, IO4, routed through the GPIO matrix
spi3_cs = Pin(4, Pin.OUT, value=1)
# CAUTION (GPIO35, input-only): Espressif: “GPIO34-39 can only be set as input mode and do not have software-enabled pullup or pulldown functions.”
uart2 = UART(2, tx=Pin(32), rx=Pin(35))  # UART 1: J2 position 7, IO32, routed through the GPIO matrix; J2 position 6, IO35, routed through the GPIO matrix
pwm1 = PWM(Pin(33))  # PWM 1: J2 position 8, IO33, routed through the GPIO matrix (LEDC CH0)
# CAUTION (GPIO36, input-only): Espressif: “GPIO34-39 can only be set as input mode and do not have software-enabled pullup or pulldown functions.”
adc1 = ADC(Pin(36))  # ADC 1: J2 position 3, VP (ADC1 CH0)
dac1 = DAC(Pin(25))  # DAC 1: J2 position 9, IO25 (DAC CH1)
gpio1 = Pin(27)  # GPIO 1: J2 position 11, IO27
"
`;

