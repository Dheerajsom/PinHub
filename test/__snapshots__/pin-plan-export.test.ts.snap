exports[`pin plan exports > arduino-uno-rev3 > matches the arduino snapshot 1`] = `
"// PinHub pin plan: Arduino UNO Rev3 (arduino-uno-rev3)
// Connector: Arduino UNO R3/R4 shield headers
// Revision notes: none recorded in PinHub; check your board's silkscreen revision.
// Verify against: Arduino UNO Rev3 full pinout PDF https://content.arduino.cc/assets/A000066-full-pinout.pdf
// Pin functions from: https://github.com/arduino/ArduinoCore-avr/blob/1.8.8/variants/standard/pins_arduino.h
// Pin functions from: https://github.com/arduino/ArduinoCore-avr/blob/1.8.8/boards.txt
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Functions/Communication/Serial.adoc
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Functions/Communication/Wire.adoc
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Functions/Communication/SPI.adoc
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Functions/Analog%20IO/analogWrite.adoc
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Variables/Constants/ledbuiltin.adoc
// Generated by PinHub — verify against the source before wiring. 2026-09-26

#pragma once
#include <Arduino.h>

const uint8_t PINHUB_WIRE_SDA = A4;  // I2C 1: Wire SDA on Analog / Power position 18, A4 / SDA
const uint8_t PINHUB_WIRE_SCL = A5;  // I2C 1: Wire SCL on Analog / Power position 19, A5 / SCL
// CAUTION (PB5, onboard-led): Arduino: “The constant LED_BUILTIN is the number of the pin to which the on-board LED is connected.” The UNO core variant defines LED_BUILTIN as 13.
const uint8_t PINHUB_SPI_SCK = 13;  // SPI 1: SPI SCK on Digital position 14, D13 / SCK
const uint8_t PINHUB_SPI_MOSI = 11;  // SPI 1: SPI MOSI on Digital position 12, D11 / COPI
const uint8_t PINHUB_SPI_MISO = 12;  // SPI 1: SPI MISO on Digital position 13, D12 / CIPO
const uint8_t PINHUB_SPI_CS = 10;  // SPI 1: SPI CS on Digital position 11, D10 / CS
const uint8_t PINHUB_PWM1 = 3;  // PWM 1: TIMER2 B on Digital position 4, D3
const uint8_t PINHUB_PWM2 = 5;  // PWM 2: TIMER0 B on Digital position 6, D5
const uint8_t PINHUB_ADC1 = A0;  // ADC 1: ADC CH0 on Analog / Power position 14, A0
const uint8_t PINHUB_GPIO1 = 2;  // GPIO 1 on Digital position 3, D2
const uint8_t PINHUB_GPIO2 = 4;  // GPIO 2 on Digital position 5, D4
"
`;

exports[`pin plan exports > arduino-uno-rev3 > matches the c-header snapshot 1`] = `
"// PinHub pin plan: Arduino UNO Rev3 (arduino-uno-rev3)
// Connector: Arduino UNO R3/R4 shield headers
// Revision notes: none recorded in PinHub; check your board's silkscreen revision.
// Verify against: Arduino UNO Rev3 full pinout PDF https://content.arduino.cc/assets/A000066-full-pinout.pdf
// Pin functions from: https://github.com/arduino/ArduinoCore-avr/blob/1.8.8/variants/standard/pins_arduino.h
// Pin functions from: https://github.com/arduino/ArduinoCore-avr/blob/1.8.8/boards.txt
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Functions/Communication/Serial.adoc
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Functions/Communication/Wire.adoc
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Functions/Communication/SPI.adoc
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Functions/Analog%20IO/analogWrite.adoc
// Pin functions from: https://github.com/arduino/reference-en/blob/b367b025a1eb/Language/Variables/Constants/ledbuiltin.adoc
// Generated by PinHub — verify against the source before wiring. 2026-09-26

#ifndef PINHUB_PLAN_ARDUINO_UNO_REV3_H
#define PINHUB_PLAN_ARDUINO_UNO_REV3_H

#include <avr/io.h>

// I2C 1: Wire SDA on Analog / Power position 18, A4 / SDA
#define PINHUB_WIRE_SDA_PORT PORTC
#define PINHUB_WIRE_SDA_DDR DDRC
#define PINHUB_WIRE_SDA_PIN PINC
#define PINHUB_WIRE_SDA_BIT PC4
// I2C 1: Wire SCL on Analog / Power position 19, A5 / SCL
#define PINHUB_WIRE_SCL_PORT PORTC
#define PINHUB_WIRE_SCL_DDR DDRC
#define PINHUB_WIRE_SCL_PIN PINC
#define PINHUB_WIRE_SCL_BIT PC5
// CAUTION (PB5, onboard-led): Arduino: “The constant LED_BUILTIN is the number of the pin to which the on-board LED is connected.” The UNO core variant defines LED_BUILTIN as 13.
// SPI 1: SPI SCK on Digital position 14, D13 / SCK
#define PINHUB_SPI_SCK_PORT PORTB
#define PINHUB_SPI_SCK_DDR DDRB
#define PINHUB_SPI_SCK_PIN PINB
#define PINHUB_SPI_SCK_BIT PB5
// SPI 1: SPI MOSI on Digital position 12, D11 / COPI
#define PINHUB_SPI_MOSI_PORT PORTB
#define PINHUB_SPI_MOSI_DDR DDRB
#define PINHUB_SPI_MOSI_PIN PINB
#define PINHUB_SPI_MOSI_BIT PB3
// SPI 1: SPI MISO on Digital position 13, D12 / CIPO
#define PINHUB_SPI_MISO_PORT PORTB
#define PINHUB_SPI_MISO_DDR DDRB
#define PINHUB_SPI_MISO_PIN PINB
#define PINHUB_SPI_MISO_BIT PB4
// SPI 1: SPI CS on Digital position 11, D10 / CS
#define PINHUB_SPI_CS_PORT PORTB
#define PINHUB_SPI_CS_DDR DDRB
#define PINHUB_SPI_CS_PIN PINB
#define PINHUB_SPI_CS_BIT PB2
// PWM 1: TIMER2 B on Digital position 4, D3
#define PINHUB_PWM1_PORT PORTD
#define PINHUB_PWM1_DDR DDRD
#define PINHUB_PWM1_PIN PIND
#define PINHUB_PWM1_BIT PD3
// PWM 2: TIMER0 B on Digital position 6, D5
#define PINHUB_PWM2_PORT PORTD
#define PINHUB_PWM2_DDR DDRD
#define PINHUB_PWM2_PIN PIND
#define PINHUB_PWM2_BIT PD5
// ADC 1: ADC CH0 on Analog / Power position 14, A0
#define PINHUB_ADC1_PORT PORTC
#define PINHUB_ADC1_DDR DDRC
#define PINHUB_ADC1_PIN PINC
#define PINHUB_ADC1_BIT PC0
#define PINHUB_ADC1_CHANNEL 0
// GPIO 1 on Digital position 3, D2
#define PINHUB_GPIO1_PORT PORTD
#define PINHUB_GPIO1_DDR DDRD
#define PINHUB_GPIO1_PIN PIND
#define PINHUB_GPIO1_BIT PD2
// GPIO 2 on Digital position 5, D4
#define PINHUB_GPIO2_PORT PORTD
#define PINHUB_GPIO2_DDR DDRD
#define PINHUB_GPIO2_PIN PIND
#define PINHUB_GPIO2_BIT PD4

#endif // PINHUB_PLAN_ARDUINO_UNO_REV3_H
"
`;

